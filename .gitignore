node_modules/
.claude/
!.claude/commands/
!.claude/commands/**
!.claude/orchestration-cortextos-node/
# Include template .claude dirs (needed for agent settings.json)
!templates/**/.claude/
!templates/**/.claude/**
dist/
ecosystem.config.js

# User-created org data (not part of the framework)
orgs/
# But community subdirectories ARE part of the framework
!community/
!community/**

# Secrets
# Inverted on purpose: ignore every .env variant, then re-admit the example.
# Enumerating suffixes (.env.local, .env.pre-rotation-…) always misses one —
# a rotated credential backup sat untracked-and-unignored until 2026-09-07.
.env
.env*
!.env.example
templates/*/.env
.cortextos-env

# Pre-modification backups — snapshots of source, never source themselves.
# Some carry rotated credentials (.backups/*.env.pre-rotation-*), so these
# directories must never be committable.
.backups/
**/.backups/

# Scratch / runtime
*.tmp.mjs
.cortextOS/

# Agent runtime data
orgs/*/agents/*/memory/
agents/*/local/
agents/*/telegram-images/
agents/*/memory/

# macOS metadata
.DS_Store

# Test artifacts
test-results/
*.log
# Spurious directory created when ${APPDATA} env var unexpanded during npm link on Windows
${APPDATA}/

# Knowledge base
knowledge-base/venv/
knowledge-base/__pycache__/
knowledge-base/scripts/__pycache__/
knowledge-base/scripts/_test_clients/__pycache__/
tests/playwright/dashboard-ui.spec.ts

# Local ops docs (personal, not for public repo)
docs/

# Internal developer/planning notes (not for public repo)
KNOWN-ISSUES.md
WINDOWS-IMPLEMENTATION-PLAN.md
WINDOWS-SUPPORT-INVESTIGATION.md
BRAINDUMP*.md
AGENTS.md
dashboard/screenshots/
dashboard/test-*.py

# Public community agent templates may intentionally include their own docs,
# AGENTS.md, memory skill, and scaffold files.
!community/agents/research-agent/
!community/agents/research-agent/**
